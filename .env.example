# Supabase project (found in Project Settings → General)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret - make up a strong random string, set it in Supabase too
TOKENBRIDGE_API_KEY=

# Google Health (OAuth credentials from Google Cloud Console)
# Authorized redirect URI: https://YOUR_PROJECT_REF.supabase.co/functions/v1/auth-callback
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=

# Withings (add when ready)
# https://developer.withings.com/developer-guide/v3/integration-guide/public-health-data-api/get-access/create-your-app/
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=

# Oura (add when ready)
# Create an app: https://cloud.ouraring.com -> My Apps -> Create New App
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# Polar (add when ready)
# Register an AccessLink app: https://www.polar.com/en/developers
# Note: access tokens never expire; participants are auto-registered with
# AccessLink on first auth (POST /v3/users) - no extra setup needed here.
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=

# Strava (add when ready)
# Create an app: https://www.strava.com/settings/api
# "Authorization Callback Domain" must be just the domain, e.g.
# YOUR_PROJECT_REF.supabase.co (not the full callback URL)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# WHOOP (add when ready)
# Register an app: https://developer.whoop.com
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Garmin (stub - requires developer program approval before these matter)
# Apply: https://developer.garmin.com/gc-developer-program/overview/
# Invite-only - do not set these until your application is approved.
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=

# Huawei Health Kit (stub - requires AppGallery Connect Health Kit scope grant)
# Register: https://developer.huawei.com/consumer/en/doc/appgallery-connect-guides/agcapi-getstarted-0000001111845114
HUAWEI_CLIENT_ID=
HUAWEI_CLIENT_SECRET=

# Dexcom - continuous glucose monitoring (stub)
# Register: https://developer.dexcom.com
# Sandbox access is immediate; production needs a short application for real users.
DEXCOM_CLIENT_ID=
DEXCOM_CLIENT_SECRET=
